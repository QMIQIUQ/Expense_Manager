rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasActiveAccount(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath) && get(userPath).data.get('isActive', true) != false;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true) ||
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminStatus == true));
    }

    function hasAcceptedConnection(ownerUid, friendUid) {
      let connectionPath = /databases/$(database)/documents/friendConnections/$(ownerUid)/friends/$(friendUid);
      return exists(connectionPath) &&
        get(connectionPath).data.status == 'accepted' &&
        get(connectionPath).data.friendUid == friendUid;
    }

    function hasFriendSharingEnabled(ownerUid, friendUid) {
      let sharingPath = /databases/$(database)/documents/friendSharing/$(ownerUid)/friends/$(friendUid);
      return exists(sharingPath) && get(sharingPath).data.enabled == true;
    }

    function hasNoAcceptedConnection(uidA, uidB) {
      return !exists(/databases/$(database)/documents/friendConnections/$(uidA)/friends/$(uidB)) &&
        !exists(/databases/$(database)/documents/friendConnections/$(uidB)/friends/$(uidA));
    }

    function validFriendRequestData(senderUid, recipientUid, status) {
      return request.resource.data.keys().hasAll(['senderUid', 'recipientUid', 'status']) &&
        request.resource.data.keys().hasOnly(['senderUid', 'recipientUid', 'status']) &&
        request.resource.data.senderUid == senderUid &&
        request.resource.data.recipientUid == recipientUid &&
        request.resource.data.status == status;
    }

    function hasAcceptedFriendRequestAfter(senderUid, recipientUid) {
      let outgoingPath = /databases/$(database)/documents/friendRequests/$(senderUid)/outgoing/$(recipientUid);
      let incomingPath = /databases/$(database)/documents/friendRequests/$(recipientUid)/incoming/$(senderUid);
      return existsAfter(outgoingPath) &&
        getAfter(outgoingPath).data.status == 'accepted' &&
        existsAfter(incomingPath) &&
        getAfter(incomingPath).data.status == 'accepted';
    }

    function canCreateFriendConnection(ownerUid, friendUid, requesterUid) {
      return (requesterUid == ownerUid && request.auth.uid == friendUid &&
          hasAcceptedFriendRequestAfter(ownerUid, friendUid)) ||
        (requesterUid == friendUid && request.auth.uid == ownerUid &&
          hasAcceptedFriendRequestAfter(friendUid, ownerUid));
    }

    function isFriendRemovalCompleteAfter(uidA, uidB) {
      return !existsAfter(/databases/$(database)/documents/friendConnections/$(uidA)/friends/$(uidB)) &&
        !existsAfter(/databases/$(database)/documents/friendConnections/$(uidB)/friends/$(uidA)) &&
        !existsAfter(/databases/$(database)/documents/friendRequests/$(uidA)/incoming/$(uidB)) &&
        !existsAfter(/databases/$(database)/documents/friendRequests/$(uidA)/outgoing/$(uidB)) &&
        !existsAfter(/databases/$(database)/documents/friendRequests/$(uidB)/incoming/$(uidA)) &&
        !existsAfter(/databases/$(database)/documents/friendRequests/$(uidB)/outgoing/$(uidA)) &&
        !existsAfter(/databases/$(database)/documents/friendSharing/$(uidA)/friends/$(uidB)) &&
        !existsAfter(/databases/$(database)/documents/friendSharing/$(uidB)/friends/$(uidA));
    }

    function validFriendConnectionData(ownerUid, friendUid) {
      return request.resource.data.keys().hasAll(['friendUid', 'requesterUid', 'status', 'connectedAt']) &&
        request.resource.data.keys().hasOnly(['friendUid', 'requesterUid', 'status', 'connectedAt']) &&
        request.resource.data.friendUid == friendUid &&
        request.resource.data.requesterUid in [ownerUid, friendUid] &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.connectedAt == request.time &&
        canCreateFriendConnection(ownerUid, friendUid, request.resource.data.requesterUid);
    }

    function validFriendSharingData() {
      return request.resource.data.keys().hasAll(['enabled', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['enabled', 'updatedAt']) &&
        request.resource.data.enabled == true &&
        request.resource.data.updatedAt == request.time;
    }

    function validFriendSpendingSummaryData() {
      return request.resource.data.keys().hasAll(['date', 'category', 'currency', 'amount', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['date', 'category', 'currency', 'amount', 'updatedAt']) &&
        request.resource.data.date is string &&
        request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        request.resource.data.category is string &&
        request.resource.data.category.size() <= 80 &&
        request.resource.data.currency in ['MYR', 'USD', 'TWD', 'SGD', 'CNY', 'EUR', 'GBP', 'JPY'] &&
        request.resource.data.amount is number &&
        request.resource.data.updatedAt == request.time;
    }

    function validFriendSpendingSummaryStateData() {
      return request.resource.data.keys().hasAll(['version', 'ready', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['version', 'ready', 'updatedAt']) &&
        request.resource.data.version == 1 &&
        request.resource.data.ready == true &&
        request.resource.data.updatedAt == request.time;
    }

    function hasValidExpenseLink(data) {
      return !('expenseId' in data) ||
        (data.expenseId is string &&
         exists(/databases/$(database)/documents/expenses/$(data.expenseId)) &&
         get(/databases/$(database)/documents/expenses/$(data.expenseId)).data.userId == data.userId);
    }

    function hasValidIncomeBudget(data) {
      return !('incomeLinkedBudget' in data) ||
        (data.incomeLinkedBudget is map &&
         data.incomeLinkedBudget.keys().hasOnly(['version', 'enabled', 'percentage', 'includeReimbursements', 'includeRepayments']) &&
         data.incomeLinkedBudget.keys().hasAll(['version', 'enabled', 'percentage', 'includeReimbursements', 'includeRepayments']) &&
         data.incomeLinkedBudget.version == 1 &&
         data.incomeLinkedBudget.enabled is bool &&
         data.incomeLinkedBudget.includeReimbursements is bool &&
         data.incomeLinkedBudget.includeRepayments is bool &&
         data.incomeLinkedBudget.percentage is number &&
         data.incomeLinkedBudget.percentage >= 0 && data.incomeLinkedBudget.percentage <= 100 &&
         data.incomeLinkedBudget.percentage * 100 >= int(data.incomeLinkedBudget.percentage * 100 + 0.5) - 0.00000001 &&
         data.incomeLinkedBudget.percentage * 100 <= int(data.incomeLinkedBudget.percentage * 100 + 0.5) + 0.00000001);
    }

    function incomeBudgetEnabled(data) {
      return data.get('incomeLinkedBudget', {}).get('enabled', false) == true;
    }

    function preservesLinkedManualLimit(before, after) {
      return !(incomeBudgetEnabled(before) && incomeBudgetEnabled(after)) ||
        before.get('overallBudgetLimits', {}).get('monthly', null) == after.get('overallBudgetLimits', {}).get('monthly', null);
    }

    function hasValidOverallBudgetLimits(data) {
      return (!('overallBudgetLimits' in data) ||
        (data.overallBudgetLimits is map &&
         data.overallBudgetLimits.keys().hasOnly(['weekly', 'monthly', 'yearly']) &&
         (!('weekly' in data.overallBudgetLimits) ||
           (data.overallBudgetLimits.weekly is number && data.overallBudgetLimits.weekly >= 0)) &&
         (!('monthly' in data.overallBudgetLimits) ||
           (data.overallBudgetLimits.monthly is number && data.overallBudgetLimits.monthly >= 0)) &&
         (!('yearly' in data.overallBudgetLimits) ||
           (data.overallBudgetLimits.yearly is number && data.overallBudgetLimits.yearly >= 0)))) &&
        (!('budgetAllocationRevision' in data) ||
          (data.budgetAllocationRevision is int && data.budgetAllocationRevision >= 0));
    }

    function hasAdvancedBudgetAllocationRevision(userId) {
      let settingsPath = /databases/$(database)/documents/userSettings/$(userId);
      let currentSettings = exists(settingsPath) ? get(settingsPath).data : {};
      let currentRevision = currentSettings.get('budgetAllocationRevision', 0);
      return existsAfter(settingsPath) &&
        currentRevision is int && currentRevision >= 0 &&
        getAfter(settingsPath).data.budgetAllocationRevision is int &&
        getAfter(settingsPath).data.budgetAllocationRevision > currentRevision;
    }
    
    // Users collection - for admin management
    match /users/{userId} {
      // Users can read their own document; admins can read any
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Allow users to create their own metadata on first login
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Allow users to update their own metadata; admins can update any
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Only admins can delete user documents
      allow delete: if isAdmin();
    }
    
    // Categories collection
    match /categories/{categoryId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/categories/$(categoryId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    function repaymentState(id, after) {
      let path = /databases/$(database)/documents/repayments/$(id);
      return after ? (existsAfter(path) ? getAfter(path).data : {}) : (exists(path) ? get(path).data : {});
    }
    function splitCounterTransition(before, after, proof) {
      let oldId = proof.beforeId;
      let newId = proof.afterId;
      let oldPaid = before.get('splitPaidMinor', {});
      let newPaid = after.get('splitPaidMinor', {});
      return newPaid is map && oldPaid is map &&
        newPaid.diff(oldPaid).affectedKeys().hasOnly([oldId, newId]) &&
        proof.beforeMinor is int && proof.beforeMinor >= 0 && proof.afterMinor is int && proof.afterMinor >= 0 &&
        (oldId == '' ? proof.beforeMinor == 0 : oldPaid.get(oldId, 0) >= proof.beforeMinor &&
          newPaid.get(oldId, 0) == oldPaid.get(oldId, 0) - proof.beforeMinor + (oldId == newId ? proof.afterMinor : 0)) &&
        (newId == '' ? proof.afterMinor == 0 :
          proof.afterIndex is int && proof.afterIndex >= 0 && proof.afterIndex < after.splitParticipants.size() &&
          after.splitParticipants[proof.afterIndex].id == newId &&
          newPaid.get(newId, 0) == oldPaid.get(newId, 0) + proof.afterMinor - (oldId == newId ? proof.beforeMinor : 0) &&
          newPaid.get(newId, 0) <= after.splitParticipants[proof.afterIndex].owedMinor);
    }
    function splitCoupledWrite(expenseId, before, after, proof) {
      let previous = repaymentState(proof.repaymentId, false);
      let next = repaymentState(proof.repaymentId, true);
      let receipt = /databases/$(database)/documents/mutationReceipts/$(request.auth.uid)/operations/$(proof.operationId);
      return after.userId == before.userId && after.get('splitParticipants', []) == before.get('splitParticipants', []) &&
        after.get('currency', 'MYR') == before.get('currency', 'MYR') &&
        previous.get('splitParticipantId', '') == proof.beforeId && (proof.beforeId == '' ? 0 : previous.get('settledExpenseMinor', 0)) == proof.beforeMinor &&
        next.get('splitParticipantId', '') == proof.afterId && (proof.afterId == '' ? 0 : next.get('settledExpenseMinor', 0)) == proof.afterMinor &&
        (previous == {} || previous.userId == before.userId && previous.expenseId == expenseId) &&
        (next == {} || next.userId == before.userId && next.expenseId == expenseId &&
          (proof.afterId == '' || next.settledExpenseCurrency == after.get('currency', 'MYR') &&
            (next.get('currency', 'MYR') != next.settledExpenseCurrency ||
              next.settledExpenseMinor >= next.amount * (next.settledExpenseCurrency == 'JPY' ? 1 : 100) - 0.000001 &&
              next.settledExpenseMinor <= next.amount * (next.settledExpenseCurrency == 'JPY' ? 1 : 100) + 0.000001))) &&
        !exists(receipt) && existsAfter(receipt) && getAfter(receipt).data.userId == before.userId && getAfter(receipt).data.committedAt == request.time &&
        splitCounterTransition(before, after, proof);
    }
    function validExpenseSplitUpdate(expenseId) {
      let before = resource.data;
      let after = request.resource.data;
      let proof = after.get('splitSettlement', {});
      return (after.get('splitPaidMinor', {}) == before.get('splitPaidMinor', {}) && proof == before.get('splitSettlement', {}) &&
          (before.get('splitPaidMinor', {}).size() == 0 || after.get('splitParticipants', []) == before.get('splitParticipants', []) && after.get('currency', 'MYR') == before.get('currency', 'MYR'))) ||
        (proof.keys().hasAll(['repaymentId', 'operationId', 'beforeId', 'beforeMinor', 'afterId', 'afterMinor', 'afterIndex']) &&
          proof.repaymentId is string && proof.operationId is string && proof.repaymentId.size() > 0 && proof.operationId.size() > 0 &&
          proof != before.get('splitSettlement', {}) && splitCoupledWrite(expenseId, before, after, proof));
    }
    function splitRepaymentCoupledWrite(repaymentId, before, after) {
      let expenseId = before.get('expenseId', after.get('expenseId', ''));
      let expense = /databases/$(database)/documents/expenses/$(expenseId);
      let nextExpense = getAfter(expense).data;
      let proof = nextExpense.get('splitSettlement', {});
      return (existsAfter(expense) && nextExpense.userId == request.auth.uid &&
          nextExpense.get('splitSettlement', {}) != get(expense).data.get('splitSettlement', {}) &&
          proof.get('repaymentId', '') == repaymentId && proof.get('beforeId', '') == before.get('splitParticipantId', '') &&
          proof.get('afterId', '') == after.get('splitParticipantId', '') &&
          proof.get('beforeMinor', 0) == (before.get('splitParticipantId', '') == '' ? 0 : before.get('settledExpenseMinor', 0)) && proof.get('afterMinor', 0) == (after.get('splitParticipantId', '') == '' ? 0 : after.get('settledExpenseMinor', 0)));
    }

    function validSplitRepaymentWrite(repaymentId, before, after) {
      return before.get('splitParticipantId', '') == '' && after.get('splitParticipantId', '') == '' || splitRepaymentCoupledWrite(repaymentId, before, after);
    }
    // Expenses collection
    match /expenses/{expenseId} {
      // Allow an authenticated transaction to check whether its stable create ID is unused.
      // Existing expense documents remain readable only by their owner or an admin.
      allow read: if isAuthenticated() && (resource == null || isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && request.resource.data.get('splitPaidMinor', {}) == {} && !request.resource.data.keys().hasAny(['splitSettlement']);
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId && validExpenseSplitUpdate(expenseId);
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin()) && resource.data.get('splitPaidMinor', {}).size() == 0;
    }
    
    // Budgets collection
    match /budgets/{budgetId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/budgets/$(budgetId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && 
                      isOwner(request.resource.data.userId) &&
                      request.resource.data.amount is number &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.categoryId is string &&
                      request.resource.data.period is string &&
                      request.resource.data.alertThreshold is number &&
                      request.resource.data.alertThreshold >= 0 &&
                      request.resource.data.alertThreshold <= 100 &&
                      // Rollover validation (optional fields)
                      (!('rolloverEnabled' in request.resource.data) || request.resource.data.rolloverEnabled is bool) &&
                      (!('rolloverPercentage' in request.resource.data) || 
                        (request.resource.data.rolloverPercentage is number &&
                         request.resource.data.rolloverPercentage >= 0 &&
                         request.resource.data.rolloverPercentage <= 100)) &&
                      (!('rolloverCap' in request.resource.data) || 
                        request.resource.data.rolloverCap is number) &&
                      (!('accumulatedRollover' in request.resource.data) || 
                        request.resource.data.accumulatedRollover is number) &&
                      hasAdvancedBudgetAllocationRevision(request.resource.data.userId);
      allow update: if isAuthenticated() && 
                       (isOwner(resource.data.userId) || isAdmin()) &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount > 0 &&
                       request.resource.data.alertThreshold is number &&
                       request.resource.data.alertThreshold >= 0 &&
                       request.resource.data.alertThreshold <= 100 &&
                       // Rollover validation (optional fields)
                       (!('rolloverEnabled' in request.resource.data) || request.resource.data.rolloverEnabled is bool) &&
                       (!('rolloverPercentage' in request.resource.data) || 
                         (request.resource.data.rolloverPercentage is number &&
                          request.resource.data.rolloverPercentage >= 0 &&
                          request.resource.data.rolloverPercentage <= 100)) &&
                       (!('rolloverCap' in request.resource.data) || 
                         request.resource.data.rolloverCap is number) &&
                       (!('accumulatedRollover' in request.resource.data) || 
                         request.resource.data.accumulatedRollover is number) &&
                       hasAdvancedBudgetAllocationRevision(resource.data.userId);
      allow delete: if isAuthenticated() &&
                    (isOwner(resource.data.userId) || isAdmin()) &&
                    hasAdvancedBudgetAllocationRevision(resource.data.userId);
    }
    
    // Recurring expenses collection
    match /recurringExpenses/{recurringId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/recurringExpenses/$(recurringId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // Cards collection (credit cards)
    match /cards/{cardId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/cards/$(cardId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // Incomes collection
    match /incomes/{incomeId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/incomes/$(incomeId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && 
                      isOwner(request.resource.data.userId) &&
                      request.resource.data.amount is number &&
                      request.resource.data.amount > 0;
      allow update: if isAuthenticated() && 
                       (isOwner(resource.data.userId) || isAdmin()) &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount > 0;
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // E-Wallets collection (electronic payment methods)
    match /ewallets/{ewalletId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/ewallets/$(ewalletId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // Banks collection (bank account management)
    match /banks/{bankId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/banks/$(bankId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // Feature Settings collection (tab visibility and ordering)
    match /featureSettings/{settingsId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/featureSettings/$(settingsId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    function reconciliationAccountOwned(data) {
      let collectionName = data.accountType == 'bank' ? 'banks' : data.accountType == 'e_wallet' ? 'ewallets' : 'cards';
      let account = get(/databases/$(database)/documents/$(collectionName)/$(data.accountId)).data;
      return account.userId == request.auth.uid && account.get('currency', 'MYR') == data.currency;
    }
    function validReconciliation(data) {
      return data.accountType in ['bank', 'e_wallet', 'credit_card'] && data.accountId is string && data.accountName is string &&
        data.currency is string && data.periodStart is string && data.periodEnd is string && data.periodStart <= data.periodEnd &&
        data.periodStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.periodEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.openingBalanceMinor is int && data.statementClosingMinor is int && data.calculatedClosingMinor is int &&
        data.revision is int && data.revision > 0 && data.status in ['draft', 'complete'] && data.sourceFingerprint is string &&
        (data.status == 'draft' || data.calculatedClosingMinor == data.statementClosingMinor && data.sourceFingerprint.matches('^[a-f0-9]{64}$')) && reconciliationAccountOwned(data);
    }
    match /accountReconciliations/{recordId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/accountReconciliations/$(recordId));
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && validReconciliation(request.resource.data) && request.resource.data.revision == 1;
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId &&
        request.resource.data.accountType == resource.data.accountType && request.resource.data.accountId == resource.data.accountId &&
        request.resource.data.periodStart == resource.data.periodStart && request.resource.data.periodEnd == resource.data.periodEnd &&
        request.resource.data.revision == resource.data.revision + 1 && validReconciliation(request.resource.data);
      allow delete: if false;
    }
    function validReconciliationMark(data) {
      let parent = getAfter(/databases/$(database)/documents/accountReconciliations/$(data.reconciliationId)).data;
      return parent.userId == request.auth.uid && parent.status == 'draft' && parent.sourceFingerprint == data.sourceFingerprint &&
        data.checked is bool && data.transactionKey is string && data.transactionKey.size() <= 200;
    }
    match /reconciliationMarks/{markId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/reconciliationMarks/$(markId));
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && validReconciliationMark(request.resource.data);
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId &&
        request.resource.data.reconciliationId == resource.data.reconciliationId && request.resource.data.transactionKey == resource.data.transactionKey && validReconciliationMark(request.resource.data);
      allow delete: if false;
    }

    // Tags are archived instead of deleting historical references.
    match /expenseTags/{tagId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/expenseTags/$(tagId));
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && validTag(request.resource.data, tagId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId && validTag(request.resource.data, tagId);
      allow delete: if false;
    }
    function validTag(data, tagId) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 40 &&
        data.normalizedName is string && data.normalizedName.size() > 0 && data.normalizedName.size() <= 40 &&
        !data.normalizedName.matches('.*/.*') && data.normalizedName == data.name.lower() &&
        data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$') && data.archived is bool &&
        (data.archived || getAfter(/databases/$(database)/documents/expenseTagNames/$(data.userId + ':' + data.normalizedName)).data.tagId == tagId);
    }
    match /expenseTagNames/{nameId} {
      allow get: if isAuthenticated() && (!exists(/databases/$(database)/documents/expenseTagNames/$(nameId)) || isOwner(resource.data.userId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) &&
        request.resource.data.tagId is string &&
        nameId == request.auth.uid + ':' + request.resource.data.normalizedName &&
        getAfter(/databases/$(database)/documents/expenseTags/$(request.resource.data.tagId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/expenseTags/$(request.resource.data.tagId)).data.normalizedName == request.resource.data.normalizedName &&
        getAfter(/databases/$(database)/documents/expenseTags/$(request.resource.data.tagId)).data.archived == false;
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && request.resource.data == resource.data;
      allow delete: if isAuthenticated() && isOwner(resource.data.userId) &&
        (getAfter(/databases/$(database)/documents/expenseTags/$(resource.data.tagId)).data.archived == true ||
         getAfter(/databases/$(database)/documents/expenseTags/$(resource.data.tagId)).data.normalizedName != resource.data.normalizedName);
    }

    function postsToAccount(row) {
      return row.get('balanceApplied', false) && row.get('paymentMethod', 'cash') in ['bank', 'e_wallet'];
    }
    function postingAccountPath(booking) {
      return booking.accountType == 'bank' ? /databases/$(database)/documents/banks/$(booking.accountId) : /databases/$(database)/documents/ewallets/$(booking.accountId);
    }
    function validPostingBooking(row) {
      return !postsToAccount(row) ? row.get('bookedAccountMovements', []) == [] :
        row.get('bookedAccountMovements', []) is list && row.bookedAccountMovements.size() == 1 &&
        validAccountBooking(row, row.bookedAccountMovements[0]);
    }
    function validAccountBooking(row, booking) {
      let path = postingAccountPath(booking);
      let before = get(path).data;
      let after = getAfter(path).data;
      let scale = booking.currency == 'JPY' ? 1 : 100;
      return booking.role == 'income' && booking.accountType == row.paymentMethod && booking.accountId is string &&
        booking.amountMinor is int && booking.amountMinor > 0 && booking.currency in ['MYR', 'USD', 'TWD', 'SGD', 'CNY', 'EUR', 'GBP', 'JPY'] &&
        before.userId == request.auth.uid && after.userId == request.auth.uid && before.get('currency', 'MYR') == booking.currency && after.get('currency', 'MYR') == booking.currency &&
        (booking.accountType == 'bank' ? row.bankId == booking.accountId : row.paymentMethodName == before.name) &&
        (row.get('currency', 'MYR') != booking.currency || booking.amountMinor >= row.amount * scale - 0.000001 && booking.amountMinor <= row.amount * scale + 0.000001);
    }
    function samePostingAccount(before, after) {
      return postsToAccount(before) && postsToAccount(after) && before.bookedAccountMovements[0].accountType == after.bookedAccountMovements[0].accountType && before.bookedAccountMovements[0].accountId == after.bookedAccountMovements[0].accountId;
    }
    function postingBalanceDelta(booking, deltaMinor) {
      let path = postingAccountPath(booking);
      let before = get(path).data;
      let after = getAfter(path).data;
      let scale = booking.currency == 'JPY' ? 1 : 100;
      return after.get('balance', 0) - before.get('balance', 0) >= deltaMinor / scale - 0.000001 &&
        after.get('balance', 0) - before.get('balance', 0) <= deltaMinor / scale + 0.000001;
    }
    function validPostingBalanceChanges(before, after) {
      return validPostingBooking(before) && validPostingBooking(after) &&
        (!postsToAccount(before) || postingBalanceDelta(before.bookedAccountMovements[0], -before.bookedAccountMovements[0].amountMinor + (samePostingAccount(before, after) ? after.bookedAccountMovements[0].amountMinor : 0))) &&
        (!postsToAccount(after) || samePostingAccount(before, after) || postingBalanceDelta(after.bookedAccountMovements[0], after.bookedAccountMovements[0].amountMinor));
    }

    function repaymentPostingProof(repaymentId, before, after) {
      let path = /databases/$(database)/documents/repaymentPostingProofs/$(repaymentId);
      let proof = getAfter(path).data;
      let receipt = /databases/$(database)/documents/mutationReceipts/$(request.auth.uid)/operations/$(proof.operationId);
      return existsAfter(path) && proof.userId == request.auth.uid &&
        (before == {} || before.userId == request.auth.uid) && (after == {} || after.userId == request.auth.uid) &&
        proof.expenseId == before.get('expenseId', after.get('expenseId', '')) &&
        proof.beforeApplied == before.get('balanceApplied', false) && proof.afterApplied == after.get('balanceApplied', false) &&
        (!exists(path) || proof.operationId != get(path).data.operationId) &&
        !exists(receipt) && existsAfter(receipt) && getAfter(receipt).data.userId == request.auth.uid && getAfter(receipt).data.committedAt == request.time &&
        (before == {} || !after.get('balanceApplied', false) || before.get('balanceApplied', false)) && validPostingBalanceChanges(before, after);
    }
    function touchedPostingProof(repaymentId) {
      let path = /databases/$(database)/documents/repaymentPostingProofs/$(repaymentId);
      return existsAfter(path) && getAfter(path).data.userId == request.auth.uid &&
        (!exists(path) || getAfter(path).data.operationId != get(path).data.operationId);
    }
    function validRepaymentPostingWrite(repaymentId, before, after) {
      return (!before.get('balanceApplied', false) && !after.get('balanceApplied', false) &&
          before.get('bookedAccountMovements', []) == [] && after.get('bookedAccountMovements', []) == []) ||
        touchedPostingProof(repaymentId);
    }
    match /repaymentPostingProofs/{repaymentId} {
      allow get: if isAuthenticated() && (resource == null || isOwner(resource.data.userId));
      allow list, delete: if false;
      allow create, update: if isAuthenticated() && request.resource.data.keys().hasOnly(['userId', 'expenseId', 'operationId', 'beforeApplied', 'afterApplied', 'updatedAt']) &&
        request.resource.data.userId == request.auth.uid && request.resource.data.updatedAt == request.time &&
        (resource == null || resource.data.userId == request.auth.uid && resource.data.expenseId == request.resource.data.expenseId) &&
        repaymentPostingProof(repaymentId, repaymentState(repaymentId, false), repaymentState(repaymentId, true));
    }

    // Repayments collection (tracks repayments against expenses)
    match /repayments/{repaymentId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/repayments/$(repaymentId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && 
                      isOwner(request.resource.data.userId) &&
                      request.resource.data.amount is number &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.expenseId is string && validSplitRepaymentWrite(repaymentId, {}, request.resource.data) && validRepaymentPostingWrite(repaymentId, {}, request.resource.data);
      allow update: if isAuthenticated() && 
                       (isOwner(resource.data.userId) || isAdmin()) &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount > 0 && request.resource.data.userId == resource.data.userId && request.resource.data.expenseId == resource.data.expenseId && validSplitRepaymentWrite(repaymentId, resource.data, request.resource.data) && validRepaymentPostingWrite(repaymentId, resource.data, request.resource.data);
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin()) && validSplitRepaymentWrite(repaymentId, resource.data, {}) && validRepaymentPostingWrite(repaymentId, resource.data, {});
    }
    
    // User Settings collection (billing cycle day and other preferences)
    match /userSettings/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && 
                      isOwner(userId) &&
                      request.resource.data.billingCycleDay is number &&
                      request.resource.data.billingCycleDay >= 1 &&
                      request.resource.data.billingCycleDay <= 31 &&
                      hasValidOverallBudgetLimits(request.resource.data) &&
                      hasValidIncomeBudget(request.resource.data);
      allow update: if isAuthenticated() && 
                       (isOwner(userId) || isAdmin()) &&
                       request.resource.data.billingCycleDay is number &&
                       request.resource.data.billingCycleDay >= 1 &&
                       request.resource.data.billingCycleDay <= 31 &&
                       hasValidOverallBudgetLimits(request.resource.data) &&
                       hasValidIncomeBudget(request.resource.data) &&
                       preservesLinkedManualLimit(resource.data, request.resource.data) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['overallBudgetLimits', 'incomeLinkedBudget']) ||
                         hasAdvancedBudgetAllocationRevision(userId));
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }
    
    // Transfers collection (tracks money transfers between payment methods)
    match /transfers/{transferId} {
      // Allow expense-delete transactions to safely check an optional transfer ID.
      // Existing transfer documents remain readable only by their owner or an admin.
      allow read: if isAuthenticated() && (resource == null || isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && 
                      isOwner(request.resource.data.userId) &&
                      request.resource.data.amount is number &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.fromPaymentMethod is string &&
                      request.resource.data.toPaymentMethod is string &&
                      hasValidExpenseLink(request.resource.data) &&
                      // Prevent transfers to the same account
                      !(request.resource.data.fromPaymentMethod == request.resource.data.toPaymentMethod &&
                        request.resource.data.fromPaymentMethod == 'cash') &&
                      !(request.resource.data.fromPaymentMethod == 'credit_card' &&
                        request.resource.data.toPaymentMethod == 'credit_card' &&
                        request.resource.data.fromCardId == request.resource.data.toCardId) &&
                      !(request.resource.data.fromPaymentMethod == 'e_wallet' &&
                        request.resource.data.toPaymentMethod == 'e_wallet' &&
                        request.resource.data.fromPaymentMethodName == request.resource.data.toPaymentMethodName) &&
                      !(request.resource.data.fromPaymentMethod == 'bank' &&
                        request.resource.data.toPaymentMethod == 'bank' &&
                        request.resource.data.fromBankId == request.resource.data.toBankId);
      allow update: if isAuthenticated() && 
                       (isOwner(resource.data.userId) || isAdmin()) &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount > 0 &&
                       hasValidExpenseLink(request.resource.data);
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // Dashboard Layouts collection (stores user's dashboard widget preferences)
    match /dashboardLayouts/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // Legacy friendship metadata remains readable by its members during migration.
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() &&
        resource.data.memberIds is list && request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if false;
    }

    // Incoming and outgoing request mirrors are written atomically by the sender.
    match /friendRequests/{userId}/incoming/{friendUid} {
      allow get: if isAuthenticated() && (isOwner(userId) || request.auth.uid == friendUid);
      allow list: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() &&
        request.auth.uid == friendUid &&
        userId != friendUid &&
        hasActiveAccount(userId) &&
        hasNoAcceptedConnection(userId, friendUid) &&
        validFriendRequestData(friendUid, userId, 'pending') &&
        existsAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/outgoing/$(userId)) &&
        getAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/outgoing/$(userId)).data.status == 'pending';
      allow update: if isAuthenticated() &&
        isOwner(userId) &&
        resource.data.status == 'pending' &&
        validFriendRequestData(friendUid, userId, 'accepted') &&
        existsAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/outgoing/$(userId)) &&
        getAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/outgoing/$(userId)).data.status == 'accepted' &&
        existsAfter(/databases/$(database)/documents/friendConnections/$(userId)/friends/$(friendUid)) &&
        existsAfter(/databases/$(database)/documents/friendConnections/$(friendUid)/friends/$(userId));
      allow delete: if isAuthenticated() &&
        ((isOwner(userId) && resource.data.status == 'pending' &&
          !existsAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/outgoing/$(userId))) ||
         (request.auth.uid in [userId, friendUid] && isFriendRemovalCompleteAfter(userId, friendUid)));
    }

    match /friendRequests/{userId}/outgoing/{friendUid} {
      allow get: if isAuthenticated() && (isOwner(userId) || request.auth.uid == friendUid);
      allow list: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() &&
        isOwner(userId) &&
        userId != friendUid &&
        hasActiveAccount(friendUid) &&
        hasNoAcceptedConnection(userId, friendUid) &&
        validFriendRequestData(userId, friendUid, 'pending') &&
        existsAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/incoming/$(userId)) &&
        getAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/incoming/$(userId)).data.status == 'pending';
      allow update: if isAuthenticated() &&
        request.auth.uid == friendUid &&
        resource.data.status == 'pending' &&
        validFriendRequestData(userId, friendUid, 'accepted') &&
        existsAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/incoming/$(userId)) &&
        getAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/incoming/$(userId)).data.status == 'accepted' &&
        existsAfter(/databases/$(database)/documents/friendConnections/$(userId)/friends/$(friendUid)) &&
        existsAfter(/databases/$(database)/documents/friendConnections/$(friendUid)/friends/$(userId));
      allow delete: if isAuthenticated() &&
        ((request.auth.uid == friendUid && resource.data.status == 'pending' &&
          !existsAfter(/databases/$(database)/documents/friendRequests/$(friendUid)/incoming/$(userId))) ||
         (request.auth.uid in [userId, friendUid] && isFriendRemovalCompleteAfter(userId, friendUid)));
    }

    // Accepting a request creates both private connection records atomically.
    match /friendConnections/{userId}/friends/{friendUid} {
      allow get: if isAuthenticated() && (isOwner(userId) || request.auth.uid == friendUid);
      allow list: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && validFriendConnectionData(userId, friendUid);
      allow update: if false;
      allow delete: if isAuthenticated() &&
        request.auth.uid in [userId, friendUid] &&
        resource.data.status == 'accepted' &&
        isFriendRemovalCompleteAfter(userId, friendUid);
    }

    // Owners control sharing; the accepted friend can read the consent flag.
    match /friendSharing/{ownerUid}/friends/{friendUid} {
      allow read: if isAuthenticated() &&
        (isOwner(ownerUid) ||
         (request.auth.uid == friendUid && hasAcceptedConnection(ownerUid, friendUid)));
      allow create, update: if isAuthenticated() &&
        isOwner(ownerUid) &&
        hasAcceptedConnection(ownerUid, friendUid) &&
        validFriendSharingData();
      allow delete: if isAuthenticated() &&
        (isOwner(ownerUid) ||
         (request.auth.uid == friendUid &&
          hasAcceptedConnection(ownerUid, friendUid) &&
          isFriendRemovalCompleteAfter(ownerUid, friendUid)));
    }

    // Daily category and currency totals are the only friend-readable spending data.
    match /friendSpendingSummaries/{ownerUid}/dailyBuckets/{bucketId} {
      allow read: if isAuthenticated() &&
        (isOwner(ownerUid) ||
         (hasActiveAccount(ownerUid) &&
          hasAcceptedConnection(ownerUid, request.auth.uid) &&
          hasFriendSharingEnabled(ownerUid, request.auth.uid)));
      allow create, update: if isAuthenticated() &&
        isOwner(ownerUid) && validFriendSpendingSummaryData();
      allow delete: if isAuthenticated() && isOwner(ownerUid);
    }

    match /friendSpendingSummaryStates/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() &&
        isOwner(userId) && validFriendSpendingSummaryStateData();
      allow delete: if false;
    }

    function hasValidFriendDashboardPreference() {
      return request.resource.data.keys().hasAll(['mode', 'period', 'selectedDate', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['mode', 'period', 'selectedDate', 'updatedAt']) &&
        request.resource.data.mode in ['total', 'categories'] &&
        request.resource.data.period in ['all', 'rolling-three-months', 'current-month', 'day'] &&
        request.resource.data.selectedDate is string &&
        request.resource.data.selectedDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        request.resource.data.updatedAt is timestamp;
    }

    // Viewing preferences belong to the viewer and are independent for each friend.
    match /friendDashboardPreferences/{userId}/friends/{friendUid} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && hasValidFriendDashboardPreference();
      allow delete: if isAuthenticated() &&
        (isOwner(userId) ||
         (request.auth.uid == friendUid && isFriendRemovalCompleteAfter(userId, friendUid)));
    }
    
    // Quick Expense Presets collection (stores user's quick expense shortcuts)
    match /quickExpensePresets/{presetId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/quickExpensePresets/$(presetId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && 
                      isOwner(request.resource.data.userId) &&
                      request.resource.data.name is string &&
                      request.resource.data.amount is number &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.categoryId is string;
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // Immutable receipts make replayed financial operations harmless after a crash.
    match /mutationReceipts/{userId}/operations/{operationId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.keys().hasOnly(['userId', 'result', 'committedAt']) &&
        request.resource.data.userId == userId &&
        request.resource.data.committedAt == request.time;
      allow update, delete: if false;
    }

    // Scheduled Payments collection (subscriptions, installments, debts)
    match /scheduledPayments/{paymentId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/scheduledPayments/$(paymentId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && 
                      isOwner(request.resource.data.userId) &&
                      request.resource.data.name is string &&
                      request.resource.data.amount is number &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.type is string &&
                      request.resource.data.frequency is string &&
                      request.resource.data.dueDay is number &&
                      request.resource.data.dueDay >= 1 &&
                      request.resource.data.dueDay <= 31;
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
    
    // Scheduled Payment Records collection (tracks individual payment confirmations)
    match /scheduledPaymentRecords/{recordId} {
      allow get: if isAuthenticated() && !exists(/databases/$(database)/documents/scheduledPaymentRecords/$(recordId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && 
                      isOwner(request.resource.data.userId) &&
                      request.resource.data.scheduledPaymentId is string &&
                      request.resource.data.expectedAmount is number &&
                      request.resource.data.actualAmount is number &&
                      request.resource.data.actualAmount > 0 &&
                      request.resource.data.paidDate is string;
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
  }
}
